APP_NAME="SkillVentura"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =====================================================================
# 1. DATABASE (MONGODB ATLAS / LOCAL MONGODB)
# =====================================================================
DB_CONNECTION=mongodb
DB_DSN="mongodb://127.0.0.1:27017"
# Contoh MongoDB Atlas:
# DB_DSN="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=SkillVentura"
DB_DATABASE=skillventura

# Driver Session, Cache, dan Queue otomatis menggunakan koleksi MongoDB
SESSION_DRIVER=mongodb
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=mongodb
QUEUE_CONNECTION=mongodb
BROADCAST_CONNECTION=log

# =====================================================================
# 2. OBJECT STORAGE (S3 / CLOUDFLARE R2 / LARAVEL CLOUD BUCKET)
# Catatan: Bucket dapat diset PRIVATE. Seluruh file di-stream via /media/{path}
# =====================================================================
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# =====================================================================
# 3. EMAIL / SMTP (GOOGLE APP PASSWORD / SMTP SERVER)
# =====================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@skillventura.com"
MAIL_FROM_NAME="${APP_NAME}"

# =====================================================================
# 4. GOOGLE OAUTH 2.0 (SOCIALITE LOGIN)
# =====================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

VITE_APP_NAME="${APP_NAME}"
